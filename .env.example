# Used by docker-compose. Copy to .env and fill in before `docker compose up`.

# Required: Groq API key for the ingredient analysis step.
GROQ_API_KEY=

# Optional: override the Groq model.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: enables the faster/more accurate Gemini Vision OCR.
# Without it the backend falls back to Tesseract.
GEMINI_API_KEY=

# URL the browser uses to reach the backend. Baked into the frontend bundle
# at build time, so change it and rebuild (`docker compose build frontend`).
VITE_BACKEND_URL=http://localhost:5000

# Host ports
BACKEND_PORT=5000
FRONTEND_PORT=8080
