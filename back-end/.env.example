# Required — Groq API key used for the ingredient analysis step.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — overrides the default Groq model.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — enables Gemini Vision OCR. Without it the server falls back to
# Tesseract, which is slower and less accurate.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional — port the API listens on (defaults to 5000).
PORT=5000

# Optional — "development" adds debug details to error responses.
NODE_ENV=development

# Optional — override the Groq chat-completions endpoint (useful for tests).
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
